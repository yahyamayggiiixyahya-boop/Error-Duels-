function T.pageBat_Version(s)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,0,0,46); f.BackgroundColor3 = Color3.fromRGB(54,11,73)
    f.BorderSizePixel = 0; T.ac(f,10)
    local fGrad = Instance.new("UIGradient",f); fGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,Color3.fromRGB(37,6,49)),ColorSequenceKeypoint.new(1,Color3.fromRGB(21,3,29))}; fGrad.Rotation = 120
    local fStk = Instance.new("UIStroke",f); fStk.Color = Color3.fromRGB(54,11,73); fStk.Thickness = 1.5; fStk.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    f.Parent = s
    local acBar = Instance.new("Frame",f); acBar.Size = UDim2.new(0,3,0,22); acBar.AnchorPoint = Vector2.new(0,0.5); acBar.Position = UDim2.new(0,8,0.5,0); acBar.BackgroundColor3 = Color3.fromRGB(156,22,204); acBar.BorderSizePixel = 0; Instance.new("UICorner",acBar).CornerRadius = UDim.new(1,0)
    T.lbl(f,"Aimbot Version",12,Enum.Font.GothamBold,Color3.fromRGB(183,115,255),UDim2.new(0,18,0,0),UDim2.new(0,110,1,0),Enum.TextXAlignment.Left)
    local versions = {"v1","v2","v3"}
    local btnW = 38; local gap = 5; local totalW = #versions*(btnW+gap)-gap
    local btns = {}
    local function updateBtns()
        for i,b in ipairs(btns) do
            if S.aimbotVersion==i then
                b.BackgroundColor3=Color3.fromRGB(156,0,190)
                b.TextColor3=Color3.fromRGB(255,255,255)
            else
                b.BackgroundColor3=Color3.fromRGB(32,6,44)
                b.TextColor3=Color3.fromRGB(140,44,199)
            end
        end
    end
    for i,lbl in ipairs(versions) do
        local vb = T.btn(f, lbl, UDim2.new(1, -totalW-12 + (i-1)*(btnW+gap), 0.5, -11), UDim2.new(0,btnW,0,22), Color3.fromRGB(32,6,44), function()
            S.aimbotVersion = i
            updateBtns()
            if S.autoBat then T.disableAutoBat(); T.enableAutoBat() end
            T.saveCfg()
        end)
        vb.TextSize = 11
        table.insert(btns, vb)
    end
    updateBtns()
end
