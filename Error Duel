function T.buildMini()
    G.mini = Instance.new("Frame")
    G.mini.Name = "ClownMini"; G.mini.Visible = false
    G.mini.Position = UDim2.new(0,50,0,50); G.mini.Size = UDim2.new(0,132,0,32)
    G.mini.BackgroundColor3 = Color3.fromRGB(21,3,28); G.mini.BorderSizePixel = 0
    -- Fully round pill
    Instance.new("UICorner", G.mini).CornerRadius = UDim.new(1,0)
    -- Gradient
    local miniGrad = Instance.new("UIGradient", G.mini)
    miniGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(40,6,53)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(21,3,28)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(14, 3, 3)),
    }
    miniGrad.Rotation = 135
    -- Glowing border
    local miniStroke = Instance.new("UIStroke", G.mini)
    miniStroke.Color = Color3.fromRGB(148,13,189); miniStroke.Thickness = 1.6
    miniStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    -- Top shimmer line
    local shimmer = Instance.new("Frame", G.mini)
    shimmer.Size = UDim2.new(0.5,0,0,1); shimmer.AnchorPoint = Vector2.new(0.5,0)
    shimmer.Position = UDim2.new(0.5,0,0,2)
    shimmer.BackgroundColor3 = Color3.fromRGB(198,55,255)
    shimmer.BackgroundTransparency = 0.5; shimmer.BorderSizePixel = 0
    Instance.new("UICorner", shimmer).CornerRadius = UDim.new(1,0)
    -- Left pulse dot + halo
    local dotGlow = Instance.new("Frame", G.mini)
    dotGlow.Size = UDim2.new(0,14,0,14); dotGlow.AnchorPoint = Vector2.new(0,0.5)
    dotGlow.Position = UDim2.new(0,8,0.5,0)
    dotGlow.BackgroundColor3 = Color3.fromRGB(198,16,252)
    dotGlow.BackgroundTransparency = 0.70; dotGlow.BorderSizePixel = 0
    Instance.new("UICorner", dotGlow).CornerRadius = UDim.new(1,0)
    local miniDot = Instance.new("Frame", G.mini)
    miniDot.Size = UDim2.new(0,7,0,7); miniDot.AnchorPoint = Vector2.new(0,0.5)
    miniDot.Position = UDim2.new(0,11,0.5,0)
    miniDot.BackgroundColor3 = Color3.fromRGB(198,27,255); miniDot.BorderSizePixel = 0
    Instance.new("UICorner", miniDot).CornerRadius = UDim.new(1,0)
    -- Right dot
    local rightDot = Instance.new("Frame", G.mini)
    rightDot.Size = UDim2.new(0,5,0,5); rightDot.AnchorPoint = Vector2.new(1,0.5)
    rightDot.Position = UDim2.new(1,-8,0.5,0)
    rightDot.BackgroundColor3 = Color3.fromRGB(198,38,255); rightDot.BorderSizePixel = 0
    Instance.new("UICorner", rightDot).CornerRadius = UDim.new(1,0)
    -- Label "Error duel"
    local miniLbl = Instance.new("TextLabel", G.mini)
    miniLbl.Size = UDim2.new(1,-30,1,0); miniLbl.Position = UDim2.new(0,22,0,0)
    miniLbl.BackgroundTransparency = 1; miniLbl.Text = "Error duel"
    miniLbl.TextColor3 = Color3.fromRGB(255,255,255); miniLbl.TextSize = 12
    miniLbl.Font = Enum.Font.GothamBlack
    miniLbl.TextXAlignment = Enum.TextXAlignment.Center
    miniLbl.TextYAlignment = Enum.TextYAlignment.Center
    -- Invisible hit target
    local miniHit = Instance.new("TextButton", G.mini)
    miniHit.Size = UDim2.new(1,0,1,0); miniHit.BackgroundTransparency = 1
    miniHit.Text = ""; miniHit.ZIndex = 5
    -- Hover
    miniHit.MouseEnter:Connect(function()
        TS:Create(miniStroke, TweenInfo.new(0.14), {Color=Color3.fromRGB(198,33,255), Thickness=2}):Play()
        TS:Create(miniDot,    TweenInfo.new(0.14), {BackgroundColor3=Color3.fromRGB(198,60,255)}):Play()
        TS:Create(dotGlow,    TweenInfo.new(0.14), {BackgroundTransparency=0.50}):Play()
        TS:Create(miniLbl,    TweenInfo.new(0.14), {TextColor3=Color3.fromRGB(198,121,255)}):Play()
    end)
    miniHit.MouseLeave:Connect(function()
        TS:Create(miniStroke, TweenInfo.new(0.14), {Color=Color3.fromRGB(148,13,189), Thickness=1.6}):Play()
        TS:Create(miniDot,    TweenInfo.new(0.14), {BackgroundColor3=Color3.fromRGB(198,27,255)}):Play()
        TS:Create(dotGlow,    TweenInfo.new(0.14), {BackgroundTransparency=0.70}):Play()
        TS:Create(miniLbl,    TweenInfo.new(0.14), {TextColor3=Color3.fromRGB(255,255,255)}):Play()
    end)
    -- Drag
    local dragging, dragStart, startPos = false, nil, nil
    G.mini.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = G.mini.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            G.mini.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X, startPos.Y.Scale, startPos.Y.Offset+delta.Y)
        end
    end)
    G.mini.Parent = G.sg
    miniHit.MouseButton1Click:Connect(function()
        S.mini = false; G.mini.Visible = false
        G.mf.Position = G.mini.Position
        T.animMenu(true)
    end)
    S.mini = false
    G.minBtn.MouseButton1Click:Connect(function()
        S.mini = not S.mini
        G.mini.Visible = S.mini
        if S.mini then
            G.mini.Position = G.mf.Position
            T.animMenu(false)
        else
            G.mf.Position = G.mini.Position
            T.animMenu(true)
        end
    end)
end
function T.buildBottom()
    -- ══════════════════════════════════════════════════════
    --  BOTTOM HUD  —  radius bar (left) + FPS widget (right)
    --  Anchor: bottom-centre of screen
    -- ══════════════════════════════════════════════════════

    -- Root container (invisible, just anchors both widgets)
    G.bb = Instance.new("Frame")
    G.bb.Name            = "BottomHUD"
    G.bb.Active          = true
    G.bb.AnchorPoint     = Vector2.new(0.5, 1)
    G.bb.Position        = UDim2.new(0.5, 0, 1, -14)
    G.bb.Size            = UDim2.new(0, 316, 0, 38)
    G.bb.BackgroundTransparency = 1
    G.bb.BorderSizePixel = 0
    G.bb.ZIndex          = 20
    G.bb.Parent          = G.sg

    -- ── RADIUS PROGRESS BAR ──────────────────────────────
    -- Signature: a charging energy-cell readout. Outer halo ring breathes,
    -- a diagonal energy sweep travels through the fill continuously, and
    -- thin tick segments mark the track like a tactical gauge.

    -- Outer glow ring (sits behind the shell, breathes with a slow pulse)
    local glowRing = Instance.new("Frame", G.bb)
    glowRing.Name              = "GlowRing"
    glowRing.AnchorPoint       = Vector2.new(0, 0.5)
    glowRing.Position          = UDim2.new(0, -5, 0.5, 0)
    glowRing.Size              = UDim2.new(0, 180, 0, 46)
    glowRing.BackgroundColor3  = Color3.fromRGB(168,30,255)
    glowRing.BackgroundTransparency = 0.86
    glowRing.BorderSizePixel   = 0
    glowRing.ZIndex            = 19
    Instance.new("UICorner", glowRing).CornerRadius = UDim.new(1, 0)

    -- Outer shell (dark glass pill with glowing border)
    local barShell = Instance.new("Frame", G.bb)
    barShell.Name            = "BarShell"
    barShell.AnchorPoint     = Vector2.new(0, 0.5)
    barShell.Position        = UDim2.new(0, 0, 0.5, 0)
    barShell.Size            = UDim2.new(0, 168, 0, 34)
    barShell.BackgroundColor3= Color3.fromRGB(9, 3, 14)
    barShell.BorderSizePixel = 0
    barShell.ZIndex          = 21
    Instance.new("UICorner", barShell).CornerRadius = UDim.new(0, 14)
    local shellStroke = Instance.new("UIStroke", barShell)
    shellStroke.Color     = Color3.fromRGB(178,30,255)
    shellStroke.Thickness = 1.6
    shellStroke.Transparency = 0.15
    shellStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    -- Subtle inner gradient on shell
    local shellGrad = Instance.new("UIGradient", barShell)
    shellGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(26,6,38)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(12, 3, 18)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(22, 5, 32)),
    }
    shellGrad.Rotation = 90

    -- Top shimmer line
    local shimmer = Instance.new("Frame", barShell)
    shimmer.Size               = UDim2.new(0.55, 0, 0, 1)
    shimmer.AnchorPoint        = Vector2.new(0.5, 0)
    shimmer.Position           = UDim2.new(0.5, 0, 0, 3)
    shimmer.BackgroundColor3   = Color3.fromRGB(218,90,255)
    shimmer.BackgroundTransparency = 0.45
    shimmer.BorderSizePixel    = 0
    shimmer.ZIndex             = 23
    Instance.new("UICorner", shimmer).CornerRadius = UDim.new(1, 0)

    -- Corner bracket accents (top-left / bottom-right) — tactical HUD detail
    local function bracket(anchor, pos, rot)
        local b = Instance.new("Frame", barShell)
        b.Size              = UDim2.new(0, 9, 0, 9)
        b.AnchorPoint        = anchor
        b.Position           = pos
        b.BackgroundTransparency = 1
        b.Rotation           = rot
        b.ZIndex             = 25
        local h = Instance.new("Frame", b)
        h.Size = UDim2.new(1,0,0,1.4); h.BackgroundColor3 = Color3.fromRGB(198,80,255)
        h.BackgroundTransparency = 0.2; h.BorderSizePixel = 0; h.ZIndex = 25
        local v = Instance.new("Frame", b)
        v.Size = UDim2.new(0,1.4,1,0); v.BackgroundColor3 = Color3.fromRGB(198,80,255)
        v.BackgroundTransparency = 0.2; v.BorderSizePixel = 0; v.ZIndex = 25
        return b
    end
    bracket(Vector2.new(0,0), UDim2.new(0,4,0,4), 0)
    bracket(Vector2.new(1,1), UDim2.new(1,-4,1,-4), 180)

    -- Track (inner glass pill the fill slides inside)
    local track = Instance.new("Frame", barShell)
    track.Name            = "Track"
    track.AnchorPoint     = Vector2.new(0.5, 0.5)
    track.Position        = UDim2.new(0.5, 0, 0.5, 0)
    track.Size            = UDim2.new(1, -14, 0, 14)
    track.BackgroundColor3= Color3.fromRGB(4, 1, 7)
    track.BorderSizePixel = 0
    track.ZIndex          = 22
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local trackStroke = Instance.new("UIStroke", track)
    trackStroke.Color = Color3.fromRGB(80,16,110)
    trackStroke.Thickness = 1
    trackStroke.Transparency = 0.5

    -- Tick segments overlaid on the track (tactical gauge texture)
    local tickHolder = Instance.new("Frame", track)
    tickHolder.Size = UDim2.new(1,0,1,0); tickHolder.BackgroundTransparency = 1
    tickHolder.ZIndex = 24; tickHolder.ClipsDescendants = false
    for i = 1, 11 do
        local t = Instance.new("Frame", tickHolder)
        t.Size            = UDim2.new(0, 1, 0.62, 0)
        t.AnchorPoint      = Vector2.new(0.5, 0.5)
        t.Position         = UDim2.new(i/12, 0, 0.5, 0)
        t.BackgroundColor3 = Color3.fromRGB(0,0,0)
        t.BackgroundTransparency = 0.55
        t.BorderSizePixel  = 0
        t.ZIndex           = 24
    end

    -- Fill frame (clips to track width via ClipsDescendants trick)
    local fillClip = Instance.new("Frame", track)
    fillClip.Name            = "FillClip"
    fillClip.Size            = UDim2.new(1, 0, 1, 0)
    fillClip.BackgroundTransparency = 1
    fillClip.BorderSizePixel = 0
    fillClip.ClipsDescendants= true
    fillClip.ZIndex          = 22

    G.pf = Instance.new("Frame", fillClip)
    G.pf.Name            = "Fill"
    G.pf.Size            = UDim2.new(0, 0, 1, 0)
    G.pf.BackgroundColor3= Color3.fromRGB(186,38,255)
    G.pf.BorderSizePixel = 0
    G.pf.ZIndex          = 23
    Instance.new("UICorner", G.pf).CornerRadius = UDim.new(1, 0)

    -- Fill gradient (vivid violet → deep purple)
