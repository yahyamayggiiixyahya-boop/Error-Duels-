-- ===================== ANTI-BYPASS (added from MOON SCRIPT PVP) =====================
local ANTI_BYPASS_HIT_DIST = 5
local ANTI_BYPASS_SWING_COOLDOWN = 0.08
local ANTI_BYPASS_FACE_OFFSET = 2.5
local antiBypassConn = nil
local antiBypassHitCd = false
S.antiBypass = false

local function antiBypassGetBat()
    return A_getBat()
end

local function antiBypassTryHit()
    if antiBypassHitCd then return end
    antiBypassHitCd = true
    pcall(function()
        local bat = antiBypassGetBat()
        if bat then
            pcall(function() bat:Activate() end)
            local remote = bat:FindFirstChildWhichIsA("RemoteEvent")
            if remote then pcall(function() remote:FireServer() end) end
        end
    end)
    task.delay(ANTI_BYPASS_SWING_COOLDOWN, function()
        antiBypassHitCd = false
    end)
end

function T.enableAntiBypass()
    if antiBypassConn then return end
    S.antiBypass = true

    antiBypassConn = RunService.Heartbeat:Connect(function()
        if not S.antiBypass then return end

        local char = LP.Character
        if not char then return end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local target, dist = A_getClosest()
        if target and target.Character then
            local tr = target.Character:FindFirstChild("HumanoidRootPart")
            if tr then
                local head = target.Character:FindFirstChild("Head")
                local basePos = head and head.Position or tr.Position
                local aimPoint = basePos + tr.CFrame.LookVector * ANTI_BYPASS_FACE_OFFSET
                local delta = aimPoint - root.Position

                if delta.Magnitude > 0.001 then
                    root.Velocity = delta.Unit * K.batSpeed
                end

                if dist <= ANTI_BYPASS_HIT_DIST and S.autoSwing then
                    antiBypassTryHit()
                end
            end
        else
            root.Velocity = Vector3.new(0, root.Velocity.Y, 0)
        end
    end)
end

function T.disableAntiBypass()
    if antiBypassConn then
        antiBypassConn:Disconnect()
        antiBypassConn = nil
    end

    S.antiBypass = false
    antiBypassHitCd = false

    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        root.Velocity = Vector3.new(0, root.Velocity.Y, 0)
    end
end

