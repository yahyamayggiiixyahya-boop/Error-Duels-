-- MOBILE BUTTONS (ported from Cursed Hub)
-- ============================================================
local MobileButtons = {
    Visible = true,
    Locked = true,
    Frame = nil,
    Containers = {},
    Buttons = {}
}

local function createMobilePanel()
    local panel = Instance.new("ScreenGui")
    panel.Name = "ClownMobileButtons"
    panel.Parent = LP:WaitForChild("PlayerGui")
    panel.ResetOnSpawn = false
    panel.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local BTN_W  = 55
    local BTN_H  = 55  -- square: same as width
    local GAP    = 9
    local COL1_X = -(BTN_W + GAP + BTN_W + 10)
    local COL2_X = -(BTN_W + 10)
    local BASE_Y = 0.45
    local ROW_Y  = {
        -((BTN_H*5+GAP*4)/2),
        -((BTN_H*5+GAP*4)/2)+(BTN_H+GAP),
        -((BTN_H*5+GAP*4)/2)+(BTN_H+GAP)*2,
        -((BTN_H*5+GAP*4)/2)+(BTN_H+GAP)*3,
        -((BTN_H*5+GAP*4)/2)+(BTN_H+GAP)*4,
    }

    local function makeSeparateBtn(name, text, defaultPos, saveKey, callback, isToggle, subLabel)
        local BTN_BG   = Color3.fromRGB(78,16,105)
        local BTN_ON   = Color3.fromRGB(156,33,211)
        local BTN_PRESS= Color3.fromRGB(70,0,85)
        local TEXT_OFF = Color3.fromRGB(156,0,190)
        local TEXT_ON  = Color3.fromRGB(255, 255, 255)
        local SHADOW   = Color3.fromRGB(46,0,57)

        local container = Instance.new("Frame")
        container.Name = name
        container.Parent = panel
        container.BackgroundColor3 = BTN_BG
        container.BackgroundTransparency = 0
        container.BorderSizePixel = 0
        container.Size = UDim2.new(0, BTN_W, 0, BTN_H)
        container.Position = defaultPos
        -- Square with rounded edges
        Instance.new("UICorner", container).CornerRadius = UDim.new(0, 16)
        -- Red border stroke on container
        local cStroke = Instance.new("UIStroke", container)
        cStroke.Color = Color3.fromRGB(93,0,114)
        cStroke.Thickness = 2
        cStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

        -- Bottom edge shadow for 3D depth
        local shadow = Instance.new("Frame", container)
        shadow.Size = UDim2.new(1, -4, 1, -4)
        shadow.Position = UDim2.new(0, 2, 0, 5)
        shadow.BackgroundColor3 = SHADOW
        shadow.BackgroundTransparency = 0.4
        shadow.BorderSizePixel = 0
        shadow.ZIndex = 1
        Instance.new("UICorner", shadow).CornerRadius = UDim.new(0, 16)

        local btn = Instance.new("TextButton", container)
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.Position = UDim2.new(0, 0, 0, 0)
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.GothamBlack
        btn.Text = text
        btn.TextColor3 = TEXT_OFF
        btn.TextSize = 12
        btn.TextWrapped = true
        btn.AutoButtonColor = false
        btn.ZIndex = 3

        -- 3D shadow text layer (offset behind main text)
        local shadowTxt = Instance.new("TextLabel", container)
        shadowTxt.Size = UDim2.new(1, 0, 1, 0)
        shadowTxt.Position = UDim2.new(0, 2, 0, 3)
        shadowTxt.BackgroundTransparency = 1
        shadowTxt.BorderSizePixel = 0
        shadowTxt.Font = Enum.Font.GothamBlack
        shadowTxt.Text = text
        shadowTxt.TextColor3 = Color3.fromRGB(62,0,76)
        shadowTxt.TextSize = 12
        shadowTxt.TextWrapped = true
        shadowTxt.TextXAlignment = Enum.TextXAlignment.Center
        shadowTxt.ZIndex = 2

        -- (sub-label removed)

        local active = false
        local function setActive(state)
            active = state
            TS:Create(container, TweenInfo.new(0.2), {BackgroundColor3 = active and BTN_ON or BTN_BG}):Play()
            TS:Create(btn, TweenInfo.new(0.2), {TextColor3 = active and TEXT_ON or TEXT_OFF}):Play()
            TS:Create(shadowTxt, TweenInfo.new(0.2), {TextColor3 = active and Color3.fromRGB(78,0,95) or Color3.fromRGB(62,0,76)}):Play()
        end

        btn.MouseButton1Down:Connect(function()
            TS:Create(container, TweenInfo.new(0.08), {BackgroundColor3 = BTN_PRESS}):Play()
        end)
        btn.MouseButton1Up:Connect(function()
            TS:Create(container, TweenInfo.new(0.25), {BackgroundColor3 = active and BTN_ON or BTN_BG}):Play()
        end)
        btn.MouseButton1Click:Connect(function()
            if isToggle then setActive(not active) end
            if callback then callback(setActive, active) end
        end)

        -- Draggable when unlocked
        local dragging, dragStart, startPos = false, nil, nil
        container.InputBegan:Connect(function(input)
            if MobileButtons.Locked then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = input.Position; startPos = container.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                container.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)

        -- Persist position
        local savedPos = nil
        pcall(function() savedPos = readfile(saveKey) end)
        if savedPos and savedPos ~= "" then
            local parts = {}
            for part in string.gmatch(savedPos, "[^,]+") do table.insert(parts, part) end
            if #parts >= 4 then
                container.Position = UDim2.new(tonumber(parts[1]), tonumber(parts[2]), tonumber(parts[3]), tonumber(parts[4]))
            end
        end
        local lastSave = 0
        container:GetPropertyChangedSignal("Position"):Connect(function()
            if tick() - lastSave > 0.5 then
                lastSave = tick()
                local pos = container.Position
                local str = string.format("%.3f,%.1f,%.3f,%.1f", pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset)
                pcall(function() writefile(saveKey, str) end)
            end
        end)

        container.Visible = MobileButtons.Visible
        table.insert(MobileButtons.Containers, container)
        return setActive
    end

    -- ── Row 1 ─────────────────────────────────────────────────────────────
    local dropBRSetActive = makeSeparateBtn("BtnDropBR", "DROP\nBR",
        UDim2.new(1, COL1_X, BASE_Y, ROW_Y[1]), "ClownBtn_dropbr.txt",
        function(setActive)
            T.runDrop()
            task.delay(0.5, function() setActive(false) end)
        end, true, "BRAINROT")

    local autoLeftSetActive = makeSeparateBtn("BtnAutoLeft", "AUTO\nLEFT",
        UDim2.new(1, COL2_X, BASE_Y, ROW_Y[1]), "ClownBtn_autoleft.txt",
        function(setActive)
            S.autoLeft = not S.autoLeft
            if S.autoLeft then
                if S.autoRight then S.autoRight = false; T.stopRight(); if G.svr then G.svr(false) end end
                if S.autoBat then S.autoBat = false; T.disableAutoBat(); if G.sbaim then G.sbaim(false) end end
                T.startLeft()
            else
                T.stopLeft()
            end
            setActive(S.autoLeft)
            if G.svl then G.svl(S.autoLeft) end
            T.saveCfg()
        end, true)

    -- ── Row 2 ─────────────────────────────────────────────────────────────
    local autoBatSetActive = makeSeparateBtn("BtnAutoBat", "BAT\nAIMBOT",
        UDim2.new(1, COL1_X, BASE_Y, ROW_Y[2]), "ClownBtn_autobat.txt",
        function(setActive)
            if not S.autoBat then
                if S.autoLeft then S.autoLeft = false; T.stopLeft(); if G.svl then G.svl(false) end end
                if S.autoRight then S.autoRight = false; T.stopRight(); if G.svr then G.svr(false) end end
                T.enableAutoBat()
                setActive(true)
                if G.sbaim then G.sbaim(true) end
            else
                S.autoBat = false; T.disableAutoBat()
                setActive(false)
                if G.sbaim then G.sbaim(false) end
            end
            T.saveCfg()
        end, true, "BAT")

    local autoRightSetActive = makeSeparateBtn("BtnAutoRight", "AUTO\nRIGHT",
        UDim2.new(1, COL2_X, BASE_Y, ROW_Y[2]), "ClownBtn_autoright.txt",
        function(setActive)
            S.autoRight = not S.autoRight
            if S.autoRight then
                if S.autoLeft then S.autoLeft = false; T.stopLeft(); if G.svl then G.svl(false) end end
                if S.autoBat then S.autoBat = false; T.disableAutoBat(); if G.sbaim then G.sbaim(false) end end
                T.startRight()
            else
                T.stopRight()
            end
            setActive(S.autoRight)
            if G.svr then G.svr(S.autoRight) end
            T.saveCfg()
        end, true)

    -- ── Row 3 ─────────────────────────────────────────────────────────────
    local tpDownSetActive = makeSeparateBtn("BtnTpDown", "TP\nDOWN",
        UDim2.new(1, COL1_X, BASE_Y, ROW_Y[3]), "ClownBtn_tpdown.txt",
        function(setActive)
            T.runTP()
            task.delay(0.5, function() setActive(false) end)
        end, true)

    local carrySpeedSetActive = makeSeparateBtn("BtnCarrySpd", "CARRY\nSPD",
        UDim2.new(1, COL2_X, BASE_Y, ROW_Y[3]), "ClownBtn_carryspd.txt",
        function(setActive)
            if S.lagger then S.lagger = false; S.phase = 0; S.speedMode = true
            else S.speedMode = not S.speedMode end
            T.refreshMode()
            setActive(S.speedMode and not S.lagger)
            T.saveCfg()
        end, true, "SPD")

    -- ── Row 4 ─────────────────────────────────────────────────────────────
    local laggerCarrySetActive = makeSeparateBtn("BtnLaggerCarry", "LAGGER\nCARRY",
        UDim2.new(1, COL1_X, BASE_Y, ROW_Y[4]), "ClownBtn_laggercarry.txt",
        function(setActive)
            if S.lagger and S.phase == 2 then
                S.lagger = false; S.phase = 0
                setActive(false)
            else
                S.speedMode = false; S.lagger = true; S.phase = 2
                setActive(true)
            end
            T.refreshMode()
            T.saveCfg()
        end, true)

    local laggerSetActive = makeSeparateBtn("BtnLaggerMode", "LAGGER\nMODE",
        UDim2.new(1, COL2_X, BASE_Y, ROW_Y[4]), "ClownBtn_laggermode.txt",
        function(setActive)
            if S.lagger and S.phase == 1 then
                S.lagger = false; S.phase = 0
                setActive(false)
            else
                S.speedMode = false; S.lagger = true; S.phase = 1
                setActive(true)
            end
            T.refreshMode()
            T.saveCfg()
        end, true)

    -- ── Row 5: Anti-Bypass screen button ─────────────────────────────────
    local antiBypassSetActive = makeSeparateBtn("BtnAntiBypass", "ANTI\nBYPASS",
        UDim2.new(1, COL1_X, BASE_Y, ROW_Y[5]), "ClownBtn_antibypass.txt",
        function(setActive)
            if S.antiBypass then
                T.disableAntiBypass()
                setActive(false)
            else
                T.enableAntiBypass()
                setActive(true)
            end
        end, true, "ANTI-BYPASS")


    MobileButtons.Buttons = {
        autoLeft    = autoLeftSetActive,
        autoRight   = autoRightSetActive,
        autoBat     = autoBatSetActive,
        carrySpeed  = carrySpeedSetActive,
        laggerMode  = laggerSetActive,
        laggerCarry = laggerCarrySetActive,
        dropBR      = dropBRSetActive,
        tpDown      = tpDownSetActive,
        antiBypass  = antiBypassSetActive,
    }

    -- Keep mobile buttons in sync with GUI / keybind state changes
    task.spawn(function()
        local last = {}
        while true do
            local cur = {
                autoLeft    = S.autoLeft,
                autoRight   = S.autoRight,
                autoBat     = S.autoBat,
                carrySpeed  = S.speedMode and not S.lagger,
                laggerMode  = S.lagger and S.phase == 1,
                laggerCarry = S.lagger and S.phase == 2,
                antiBypass  = S.antiBypass == true,
            }
            for key, val in pairs(cur) do
                if last[key] ~= val then
                    last[key] = val
                    if MobileButtons.Buttons[key] then MobileButtons.Buttons[key](val) end
                end
            end
            task.wait(0.2)
        end
    end)

    return panel
end

task.spawn(function()
    task.wait(0.5)
    createMobilePanel()
end)

