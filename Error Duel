        speedBillLbl.TextScaled = true
        speedBillLbl.TextStrokeTransparency = 0.1
        speedBillLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    end

    local ragTimerActive = false
    local function startRagdollTimer()
        if ragTimerActive then return end
        ragTimerActive = true
        S.countdownActive = true

        -- Stop auto left and right immediately
        if S.autoLeft then T.stopLeft() end
        if S.autoRight then T.stopRight() end

        task.spawn(function()
            local char2 = LP.Character
            local head2 = char2 and char2:FindFirstChild("Head")
            local bb2 = head2 and head2:FindFirstChild("ClownHubBB")
            local timerLbl = bb2 and bb2:FindFirstChild("RagdollTimerLbl")
            if not timerLbl then ragTimerActive = false; S.countdownActive = false; return end
            local countdown = 3
            timerLbl.Visible = true
            while countdown > 0 do
                timerLbl.Text = tostring(countdown)
                timerLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
                task.wait(1)
                countdown = countdown - 1
            end
            timerLbl.Text = "READY TO STEAL"
            timerLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
            repeat task.wait(0.1) until (function()
                local c3 = LP.Character
                local hum3 = c3 and c3:FindFirstChildOfClass("Humanoid")
                if not hum3 then return true end
                local st3 = hum3:GetState()
                return st3 ~= Enum.HumanoidStateType.Physics
                    and st3 ~= Enum.HumanoidStateType.Ragdoll
                    and st3 ~= Enum.HumanoidStateType.FallingDown
            end)()
            timerLbl.Visible = false
            timerLbl.Text = ""
            ragTimerActive = false
            S.countdownActive = false

            -- Resume auto left/right if they were on
            if S.autoLeft then T.startLeft() end
            if S.autoRight then T.startRight() end
        end)
    end

    RunService.Heartbeat:Connect(function()
        local hum2 = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if not hum2 then return end
        local st = hum2:GetState()
        if st == Enum.HumanoidStateType.Physics
            or st == Enum.HumanoidStateType.Ragdoll
            or st == Enum.HumanoidStateType.FallingDown then
            startRagdollTimer()
        end
    end)
end)
